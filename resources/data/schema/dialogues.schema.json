{
  "$comment": "dialogues.json：两类对话框（路人 / 朋友）的台词。group 与两组人设定对应，先取 real/imaginary 与 friend/stranger 两套别名。",
  "type": "object",
  "required": ["dialogues"],
  "properties": {
    "dialogues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "lines"],
        "properties": {
          "id": { "type": "string" },
          "group": { "type": "string", "enum": ["real", "imaginary", "friend", "stranger"] },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["speaker", "text"],
              "properties": {
                "speaker": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
